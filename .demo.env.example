# Copy this to .demo.env (gitignored) and fill in your keys, then run ./demo.sh
export NESSIE_API_KEY=your_nessie_key          # the key that OWNS the demo accounts
export GATEKEEPER_PORT=/dev/cu.usbserial-0001  # your board's serial port
export GATEKEEPER_VOICE=1                       # 1 = speak verdicts on the MacBook
export ELEVEN_KEY=your_elevenlabs_key
# export ELEVEN_VOICE_ID=...                    # optional; a default voice is used otherwise
export OPENROUTER_KEY=your_openrouter_key       # for ./demo_hijack.sh (live weak-model hijack)
# export HIJACK_MODEL=mistralai/ministral-8b-2512   # model demo_hijack.sh injects (new + small)
export NESSIE_ACME_MERCHANT=your_acme_merchant_id   # from nessie.py setup; vendor-payment audit trail
export GATEKEEPER_DEMO_CLEAN=1               # clean starting balances + empty trail for recording
